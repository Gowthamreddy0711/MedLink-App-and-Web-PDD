rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );
    }

    // --- LEAVE REQUESTS ---
    match /leaveRequests/{requestId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (
        resource == null ||
        resource.data.doctorId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id == resource.data.doctorId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN'
      );

      // --- VOLUNTEERS (DIAGNOSTIC VERSION) ---
      match /volunteers/{volunteerId} {
        allow read, write: if request.auth != null && (
          volunteerId == request.auth.uid ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.id == volunteerId
        );
      }
    }

    // --- OTHER COLLECTIONS ---
    match /appointments/{id} { allow read, write: if request.auth != null; }
    match /prescriptions/{id} { allow read, write: if request.auth != null; }
    match /queueStatus/{id} { allow read, write: if request.auth != null; }
    match /queueItems/{id} { allow read, write: if request.auth != null; }
    match /notifications/{id} { allow read, write: if request.auth != null; }
    match /adminNotifications/{id} { allow read, write: if request.auth != null; }
    match /adminActivityLogs/{id} { allow read, write: if request.auth != null; }
    match /doctorSchedules/{id} { allow read, write: if request.auth != null; }
    match /reviews/{id} { allow read: if true; allow create: if request.auth != null; }
  }
}
