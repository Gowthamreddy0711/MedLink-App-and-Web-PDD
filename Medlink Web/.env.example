# MedLink Web — Environment Configuration
#
# Firebase configuration is handled in src/firebase/config.ts (env prefix: VITE_)
# Cloudinary upload endpoint: /api/cloudinary-upload (no API key required in this config)
#
# APP_URL: The URL where this app is hosted (used for self-referential links).
APP_URL="MY_APP_URL"

# VITE_SENTIMENT_API_URL: The URL of the local or remote sentiment analysis Python FastAPI service
VITE_SENTIMENT_API_URL="http://127.0.0.1:8000"

# GEMINI_API_KEY: The server-side API key for Gemini sentiment analysis
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
