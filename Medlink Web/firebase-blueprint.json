{
  "entities": {
    "User": {
      "title": "Doctor User Profile",
      "description": "Healthcare practitioner profile information including license, hospital, specialty, and availability.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "licenseNumber": { "type": "string" },
        "licenseStatus": { "type": "string", "enum": ["Verified", "Pending", "Expired"] },
        "specialty": { "type": "string" },
        "qualification": { "type": "string" },
        "experienceYears": { "type": "number" },
        "hospital": { "type": "string" },
        "department": { "type": "string" },
        "photoUrl": { "type": "string" },
        "phone": { "type": "string" },
        "bio": { "type": "string" },
        "isAvailableForCoverage": { "type": "boolean" },
        "location": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "email", "licenseNumber", "specialty", "hospital"]
    },
    "LeaveRequest": {
      "title": "Shift Coverage or Leave Request",
      "description": "Shift leave request or coverage demand submitted by a doctor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requesterUid": { "type": "string" },
        "requesterName": { "type": "string" },
        "requesterSpecialty": { "type": "string" },
        "requesterPhoto": { "type": "string" },
        "hospital": { "type": "string" },
        "department": { "type": "string" },
        "shiftDate": { "type": "string" },
        "shiftType": { "type": "string", "enum": ["Day Shift", "Night Shift", "On-Call", "ICU Shift", "ER Shift", "24hr Duty"] },
        "reason": { "type": "string" },
        "urgency": { "type": "string", "enum": ["Normal", "Urgent", "Emergency"] },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["Open", "Volunteer Offered", "Assigned", "Completed", "Cancelled"] },
        "assignedVolunteerUid": { "type": "string" },
        "assignedVolunteerName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "requesterUid", "requesterName", "shiftDate", "shiftType", "status"]
    },
    "Volunteer": {
      "title": "Volunteer Coverage Offer",
      "description": "Offer submitted by a peer doctor to cover an open leave request.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "volunteerUid": { "type": "string" },
        "volunteerName": { "type": "string" },
        "volunteerPhoto": { "type": "string" },
        "volunteerSpecialty": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Declined"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "requestId", "volunteerUid", "volunteerName", "status"]
    },
    "ChatRoom": {
      "title": "Chat Room",
      "description": "Communication channel between two healthcare practitioners.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participantUids": { "type": "array" },
        "participantNames": { "type": "object" },
        "participantPhotos": { "type": "object" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "unreadCounts": { "type": "object" }
      },
      "required": ["id", "participantUids"]
    },
    "Message": {
      "title": "Direct Message",
      "description": "Instant message sent within a chat room.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatRoomId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "chatRoomId", "senderUid", "text", "timestamp"]
    },
    "Notification": {
      "title": "In-App Notification",
      "description": "System or coverage activity notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUid": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string", "enum": ["coverage_request", "volunteer_offer", "volunteer_approval", "chat_message", "notice_alert"] },
        "relatedId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientUid", "title", "body", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Doctor user profile document."
    },
    "/leaveRequests/{requestId}": {
      "schema": { "$ref": "LeaveRequest" },
      "description": "Shift leave and coverage requests collection."
    },
    "/volunteers/{volunteerId}": {
      "schema": { "$ref": "Volunteer" },
      "description": "Volunteer offers for shift coverage."
    },
    "/chatRooms/{roomId}": {
      "schema": { "$ref": "ChatRoom" },
      "description": "Chat conversations between doctors."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "Message" },
      "description": "Chat messages collection."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "Notification" },
      "description": "Real-time user notifications."
    }
  }
}
